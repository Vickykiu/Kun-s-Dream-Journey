[sub_resource type="Shader" id="CutoutShader"]
code = "shader_type canvas_item;
void fragment() {
    vec4 pixel = texture(TEXTURE, UV);
    float minimum_channel = min(pixel.r, min(pixel.g, pixel.b));
    float maximum_channel = max(pixel.r, max(pixel.g, pixel.b));
    float neutral_color = 1.0 - smoothstep(0.025, 0.11, maximum_channel - minimum_channel);
    float near_white = smoothstep(0.955, 0.995, minimum_channel);
    pixel.a *= 1.0 - (near_white * neutral_color);
    COLOR = pixel;
}
"

[sub_resource type="ShaderMaterial" id="CutoutMaterial"]
shader = SubResource("CutoutShader")

