[node name="Body" type="Label" parent="Center/ChapterCard/Column" unique_id=190598649]
layout_mode = 2
theme_override_colors/font_color = Color(0.66, 0.61, 0.55, 1)
theme_override_font_sizes/font_size = 18
text = "Today is Kunkun's first day at the Starlight Training Camp.
He arrives with one dream: to finish his training and become a shining star.
The camp appears cheerful and welcoming, yet its unfamiliar faces leave him uneasy.
Teacher Mei is waiting inside the practice room.
His first lesson is a simple rhythm-training performance.
At least, that is what Kunkun has been told."
horizontal_alignment = 1

